{
  "multipart": [
    {
      "apply": {
        "model": "mechanical_drive:block/angle_gear/angle_gear"
      }
    },
    {
      "when": {
        "encased": "true"
      },
      "apply": {
        "model": "mechanical_drive:block/angle_gear/angle_gear_encased_frame"
      }
    },
    {
      "when": {
        "encased": "true",
        "north": "true"
      },
      "apply": {
        "model": "mechanical_drive:block/angle_gear/angle_gear_encased_panel_north_gearbox"
      }
    },
    {
      "when": {
        "encased": "true",
        "north": "false"
      },
      "apply": {
        "model": "mechanical_drive:block/angle_gear/angle_gear_encased_panel_north_casing"
      }
    },
    {
      "when": {
        "encased": "true",
        "south": "true"
      },
      "apply": {
        "model": "mechanical_drive:block/angle_gear/angle_gear_encased_panel_south_gearbox"
      }
    },
    {
      "when": {
        "encased": "true",
        "south": "false"
      },
      "apply": {
        "model": "mechanical_drive:block/angle_gear/angle_gear_encased_panel_south_casing"
      }
    },
    {
      "when": {
        "encased": "true",
        "west": "true"
      },
      "apply": {
        "model": "mechanical_drive:block/angle_gear/angle_gear_encased_panel_west_gearbox"
